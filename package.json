
{
  "name": "cinephile",
  "private": true,
  "scripts": {
    "frontend": "npm --prefix frontend run dev",
    "backend": "cd backend && mvnw spring-boot:run -Dmaven.test.skip=true",
    "ml": "python -m uvicorn api.app:app --app-dir machine_learning --host 0.0.0.0 --port 8000",
    "frontend:wait": "wait-on tcp:localhost:8080 && npm run frontend",
    "dev": "concurrently -n \"backend,frontend,ml\" -c \"magenta,cyan,yellow\" \"npm run backend\" \"npm run frontend:wait\" \"npm run ml\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report docs/qa/reports/html",
    "test:e2e:smoke": "playwright test tests/e2e/homepage.spec.js tests/e2e/auth.spec.js",
    "test:report": "playwright show-report docs/qa/reports/html",
    "test:debug": "playwright test --debug",
    "test:accessibility": "playwright test tests/accessibility",
    "test:visual": "playwright test tests/visual",
    "test:random": "playwright test tests/generated",
    "test:inventory": "playwright test tests/e2e/site-inventory.spec.js",
    "test:layout": "playwright test tests/accessibility/layout.spec.js",
    "test:all": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.1"
  }
}
