# ==============================================================================
# Cinephile Monorepo - Git Ignore Rules
# ==============================================================================

# --- Node & Frontend ---
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Java / Maven / Spring Boot ---
target/
**/target/
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear

# --- Python & Machine Learning ---
machine_learning/.venv/
machine_learning/env/
machine_learning/venv/
machine_learning/__pycache__/
machine_learning/*/__pycache__/
.venv/
env/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/

# --- Large Raw Datasets (Not required for inference) ---
machine_learning/data/raw/
machine_learning/data/raw/credits.csv

# --- Flutter & Mobile ---
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies/
**/build/
**/coverage/
**/local.properties

# --- IDEs & OS Files ---
.idea/
**/.idea/
.vscode/
**/.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# --- Environment Files & Secrets ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*service-account*.json
*firebase-adminsdk*.json

# --- Playwright Test Artifacts & Logs ---
playwright-report/
test-results/
docs/qa/reports/html/
docs/qa/reports/screenshots/
*.log
